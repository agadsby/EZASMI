         ST    R2,8(R13)            .. save ..                          00045200
         LR    R13,R2                 .. areas                          00045300
         LA    R5,GETLINE       address ..                              00045400
         BCTR  R5,0                      .. length of ..                00045500
         BCTR  R5,0                                    .. mainline code 00045600
